# Copy this file to .env to connect the shop to the Laravel backend.
# Without VITE_API_URL, the shop uses its fake backend (src/services/fakeBackend.ts).
#
# Use the same hostname as the page (127.0.0.1, not localhost), or the backend's cookies
# won't be sent and placing an order fails with 419. See backend/docs/API.md.
VITE_API_URL=http://127.0.0.1:8000
